                MessageBox.Show("Thank you for your order!", "Order Placed", MessageBoxButtons.OK, MessageBoxIcon.Information);
            }
            else
            {
                MessageBox.Show("Order cancelled.", "Order Cancelled", MessageBoxButtons.OK, MessageBoxIcon.Information);
            }
            
        }

