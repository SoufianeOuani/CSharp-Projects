        private void btnOrderPizza_Click(object sender, EventArgs e)
        {
            if (MessageBox.Show($"Size: {selectedSize}\nCrust Type: {selectedCrustType}\n" +
                $"Where to eat: {selectedWhereToEat}\nToppings: {lblToppingsData.Text}\n" +
                $"Total Price: ${totalPrice.ToString()}", 
                "Order Summary", MessageBoxButtons.OKCancel, 
                MessageBoxIcon.Information, MessageBoxDefaultButton.Button2) == DialogResult.OK)
