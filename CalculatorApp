using System;
using System.Windows.Forms;

namespace MyFirstWindowsForms
{
    public partial class Form1 : Form
    {
        public Form1()
        {
            InitializeComponent();
        }

        float Result = 0.0f;
        float FirstNumber = 0.0f;
        string Operation = "";

        private void Add_Click(object sender, EventArgs e)
        {
            FirstNumber = float.Parse(label1.Text);
            Operation = "+";
            label1.Text = "";
        }

        private void Subtract_Click(object sender, EventArgs e)
        {
            FirstNumber = float.Parse(label1.Text);
            Operation = "-";
            label1.Text = "";
        }

        private void Multiply_Click(object sender, EventArgs e)
        {
            FirstNumber = float.Parse(label1.Text);
            Operation = "x";
            label1.Text = "";
        }

        private void Divide_Click(object sender, EventArgs e)
        {
            FirstNumber = float.Parse(label1.Text);
            Operation = "/";
            label1.Text = "";
        }

        private void Mod_Click(object sender, EventArgs e)
        {
            FirstNumber = float.Parse(label1.Text);
            Operation = "%";
            label1.Text = "";
        }

        private void Delete_Click(object sender, EventArgs e)
        {
            if (label1.Text.Length > 0)
            {
                label1.Text = label1.Text.Substring(0, label1.Text.Length - 1);
            }
        }

        private void Clear_Click(object sender, EventArgs e)
        {
            label1.Text = "";
            FirstNumber = 0.0f;
            Operation = "";
            Result = 0.0f;
        }

        private void Zero_Click(object sender, EventArgs e)
        {
            label1.Text += Zero.Text;
        }

        private void One_Click(object sender, EventArgs e)
        {
            label1.Text += One.Text;
        }

        private void Two_Click(object sender, EventArgs e)
        {
            label1.Text += Two.Text;
        }

        private void Three_Click(object sender, EventArgs e)
        {
            label1.Text += Three.Text;
        }

        private void Four_Click(object sender, EventArgs e)
        {
            label1.Text += Four.Text;
        }

        private void Five_Click(object sender, EventArgs e)
        {
            label1.Text += Five.Text;
        }

        private void Six_Click(object sender, EventArgs e)
        {
            label1.Text += Six.Text;
        }

        private void Seven_Click(object sender, EventArgs e)
        {
            label1.Text += Seven.Text;
        }

        private void Eight_Click(object sender, EventArgs e)
        {
            label1.Text += Eight.Text;
        }

        private void Nine_Click(object sender, EventArgs e)
        {
            label1.Text += Nine.Text;
        }

        private void Comma_Click(object sender, EventArgs e)
        {
            if (!label1.Text.Contains("."))
            {
                label1.Text += ".";
            }
        }

        private void Equals_Click(object sender, EventArgs e)
        {
            float SecondNumber = float.Parse(label1.Text);

            switch (Operation)
            {
                case "+":
                    Result = FirstNumber + SecondNumber;
                    break;
                case "-":
                    Result = FirstNumber - SecondNumber;
                    break;
                case "x":
                    Result = FirstNumber * SecondNumber;
                    break;
                case "/":
                    if (SecondNumber != 0)
                    {
                        Result = FirstNumber / SecondNumber;
                    }
                    else
                    {
                        label1.Text = "Error";
                        return;
                    }
                    break;
                case "%":
                    Result = FirstNumber % SecondNumber;
                    break;
                default:
                    Result = SecondNumber;
                    break;
            }

            label1.Text = Result.ToString();
        }
    }
}
